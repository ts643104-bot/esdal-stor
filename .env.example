# إعدادات قاعدة البيانات Supabase (لجعل المنتجات والمبيعات عامة لجميع المستخدمين)
# قم بإنشاء حساب في supabase.com وضع الروابط والمفاتيح هنا
VITE_SUPABASE_URL="ضع_رابط_المشروع_هنا"
VITE_SUPABASE_ANON_KEY="ضع_مفتاح_anon_هنا"

# إعدادات Firebase (إذا كنت تستخدم Firebase للتوثيق أو قاعدة البيانات)
VITE_FIREBASE_API_KEY="ضع_api_key_هنا"
VITE_FIREBASE_AUTH_DOMAIN="ضع_auth_domain_هنا"
VITE_FIREBASE_DATABASE_URL="ضع_database_url_هنا"
VITE_FIREBASE_PROJECT_ID="ضع_project_id_هنا"
VITE_FIREBASE_STORAGE_BUCKET="ضع_storage_bucket_هنا"
VITE_FIREBASE_MESSAGING_SENDER_ID="ضع_messaging_sender_id_هنا"
VITE_FIREBASE_APP_ID="ضع_app_id_هنا"
VITE_FIREBASE_MEASUREMENT_ID="ضع_measurement_id_هنا"

# إعدادات ImgBB لرفع الصور
VITE_IMGBB_API_URL="https://api.imgbb.com/1/upload"
VITE_IMGBB_API_KEY="ضع_api_key_هنا"

# الطريقة القديمة (في حال استخدام Google Sheets بدلاً من Supabase كـ Fallback)
VITE_GOOGLE_SHEET_CSV_URL=""
