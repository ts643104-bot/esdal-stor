rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@hala-alyusr.com'
      );
    }

    function isMoney(value) {
      return value is number && value >= 0 && value <= 1000000;
    }

    function validOrder() {
      return request.resource.data.keys().hasAll([
        'userId', 'date', 'items', 'total', 'status', 'paymentMethod',
        'customerName', 'customerPhone', 'customerAddress', 'governorate'
      ])
      && request.resource.data.userId == request.auth.uid
      && request.resource.data.status == 'pending'
      && request.resource.data.paymentMethod in ['cod', 'online']
      && request.resource.data.customerName is string
      && request.resource.data.customerName.size() >= 2
      && request.resource.data.customerName.size() <= 120
      && request.resource.data.customerPhone is string
      && request.resource.data.customerPhone.matches('^01[0125][0-9]{8}$')
      && request.resource.data.customerAddress is string
      && request.resource.data.customerAddress.size() >= 6
      && request.resource.data.customerAddress.size() <= 500
      && request.resource.data.governorate is string
      && request.resource.data.governorate.size() > 0
      && request.resource.data.items is list
      && request.resource.data.items.size() > 0
      && isMoney(request.resource.data.total);
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && validOrder();
      allow update, delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promoCodes/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
