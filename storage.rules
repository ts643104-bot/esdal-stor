rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'admin@hala-alyusr.com'
      );
    }

    // Product images: public read, only admin can write
    match /products/{imageId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Payment receipts: Secure access (Admin or Owner only)
    match /receipts/{uid}/{receiptId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
